# 对应仓库根目录 Docker Compose 启动的本地 PostgreSQL。
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5434/erp-simple

# 前端通过 Vite 的 /api 代理访问后端。
SERVER_PORT=4201
BETTER_AUTH_URL=http://localhost:4200

# 运行 openssl rand -base64 32，把生成的值填入本地 .env。
BETTER_AUTH_SECRET=

# 供 bun run auth:init-admin 使用。邮箱须尚未注册，密码至少 8 个字符。
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
