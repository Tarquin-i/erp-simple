# 对应仓库根目录 Docker Compose 启动的本地 PostgreSQL。
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5434/erp-simple

# 前端通过 Vite 的 /api 代理访问后端。
SERVER_PORT=4201
BETTER_AUTH_URL=http://localhost:4200

# 运行 openssl rand -base64 32，把生成的值填入本地 .env。
BETTER_AUTH_SECRET=

# 供 bun run auth:init-admin 使用。邮箱须尚未注册，密码至少 8 个字符。
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# 本地附件目录须位于仓库和静态文件服务目录之外。相对路径以 API 工作目录为基准。
# 未设置存储模式时沿用 OSS。
COMMUNICATION_ATTACHMENT_STORAGE=local
COMMUNICATION_ATTACHMENT_LOCAL_DIR=../../../.erp-simple-private/communication-attachments

# 使用 OSS 时将存储模式设为 oss，并配置未开启过版本控制的私有 Bucket。
# 浏览器直传需要在 Bucket 的 CORS 中允许前端来源、PUT 和签名请求头。
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=
# 可选的单文件上限，单位为字节。可低于本地模式的 128 MiB 或 OSS 模式的 5 GiB。
# COMMUNICATION_ATTACHMENT_MAX_BYTES=104857600
