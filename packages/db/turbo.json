{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "db:push": {
      "cache": false,
      "outputs": [],
      "passThroughEnv": [
        "DATABASE_URL",
        "NODE_ENV",
        "APP_ENV",
        "VERCEL_ENV",
        "ENVIRONMENT"
      ]
    },
    "db:reset": {
      "cache": false,
      "outputs": [],
      "passThroughEnv": [
        "DATABASE_URL",
        "NODE_ENV",
        "APP_ENV",
        "VERCEL_ENV",
        "ENVIRONMENT"
      ]
    },
    "db:studio": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"],
      "persistent": true
    }
  }
}
